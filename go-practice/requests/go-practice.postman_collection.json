{
  "info": {
    "name": "go-practice — 자료 등록부터 읽음 변경까지",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "make up 후 위에서 아래로 실행합니다. 목록 생성 응답의 ID는 컬렉션 변수 listID에 자동 저장합니다. 새 목록은 requestKey를 변경하세요."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "resourceOneID",
      "value": "go-tour",
      "type": "string"
    },
    {
      "key": "resourceTwoID",
      "value": "go-context",
      "type": "string"
    },
    {
      "key": "requestKey",
      "value": "first-java-go-001",
      "type": "string"
    },
    {
      "key": "listID",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 서버 확인",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 첫 자료 등록/수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/resources/{{resourceOneID}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"A Tour of Go\",\n  \"url\": \"https://go.dev/tour/\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 두 번째 자료 등록/수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/resources/{{resourceTwoID}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Go Context\",\n  \"url\": \"https://pkg.go.dev/context\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 자료 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/resources"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 목록 생성 (listID 자동 저장)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/lists",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestKey\": \"{{requestKey}}\",\n  \"title\": \"Go 시작하기\",\n  \"resourceIds\": [\n    \"{{resourceOneID}}\",\n    \"{{resourceTwoID}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set(\"listID\", pm.response.json().readingList.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 목록 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/lists/{{listID}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 읽음 변경",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/lists/{{listID}}/items/{{resourceOneID}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isRead\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 대시보드",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/dashboard/{{listID}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 미읽음 변경",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/lists/{{listID}}/items/{{resourceOneID}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isRead\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 변경 결과 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/lists/{{listID}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
